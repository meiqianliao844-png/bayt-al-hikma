{
  "name": "bayt-al-hikma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync:assets": "npm run convert:news && npm run convert:sponge && npm run convert:corpus && npm run convert:mystery && npm run convert:mystery02 && npm run convert:foldable && npm run convert:literature && node scripts/sync-assets.mjs",
    "predev": "npm run sync:assets",
    "prebuild": "npm run sync:assets",
    "format": "prettier --write src tests scripts *.ts *.json *.md docs .github",
    "convert:news": "node scripts/convert-news.mjs",
    "convert:sponge": "node scripts/convert-news.mjs --input data/imports/spongebob-01.portable.json --output src/data/spongebob-01.json --report src/data/spongebob-01.report.json",
    "convert:corpus": "node scripts/convert-corpus.mjs",
    "convert:mystery": "node scripts/convert-mystery.mjs",
    "convert:mystery02": "node scripts/convert-mystery02.mjs",
    "convert:foldable": "node scripts/convert-foldable.mjs",
    "convert:literature": "node scripts/import-literature.mjs"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "ajv": "^8.17.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
