  "transcript": [
    {
      "id": "L01",
      "arabic": "هَذَا الْمَكَانُ مَهْجُورٌ.",
      "chinese": "这地方空无一人。"
    },
    {
      "id": "L02",
      "arabic": "عَلَى مَا أَتَذَكَّرُ، نَجِدُ سُكَّانَ قَاعِ الْمُحِيطِ اللُّطَفَاءَ عِنْدَ مَوْقِفِ الْحَافِلَةِ.",
      "chinese": "我记得，在公交车站能找到那些友善的比奇堡居民。"
    },
    {
      "id": "L03",
      "arabic": "يَا لَهَا مِنْ فِكْرَةٍ رَائِعَةٍ، يَا سْبُونْج بُوب! يُوجَدُ هُنَاكَ الْكَثِيرُ مِنَ الْعُمَلَاءِ.",
      "chinese": "真是个好主意啊，海绵宝宝！这里可真是顾客成群呢。"
    },
    {
      "id": "L04",
      "arabic": "رُبَّمَا هُمْ فِي مَرْكَزِ التَّسَوُّقِ.",
      "chinese": "说不定他们在购物中心。"
    },
    {
      "id": "L05",
      "arabic": "آه، مَرْكَزُ التَّسَوُّقِ.",
      "chinese": "哦，购物中心。"
    },
    {
      "id": "L06",
      "arabic": "أَيْنَ ذَهَبَ الْجَمِيعُ؟",
      "chinese": "大家都去哪儿了？"
    },
    {
      "id": "L07",
      "arabic": "السِّيرْكُ مَكَانٌ رَائِعٌ لِلتَّجَمُّعَاتِ.",
      "chinese": "马戏团可是个聚会的好地方。"
    },
    {
      "id": "L08",
      "arabic": "رُبَّمَا هُوَ سِيرْكُ الْبَرَاغِيثِ.",
      "chinese": "没准是个跳蚤马戏团呢。"
    },
    {
      "id": "L09",
      "arabic": "لَا يَزَالُ دَافِئًا.",
      "chinese": "还热乎着呢。"
    },
    {
      "id": "L10",
      "arabic": "الْمَدَافِنُ خَالِيَةٌ أَيْضًا.",
      "chinese": "连墓地都空无一人。"
    },
    {
      "id": "L11",
      "arabic": "هَذِهِ لَيْسَتْ مَدِينَةَ أَشْبَاحٍ حَتَّى.",
      "chinese": "这里连鬼城都算不上。"
    },
    {
      "id": "L12",
      "arabic": "حَاوَلْنَا، هَيَّا لِنَعُدْ.",
      "chinese": "反正我们也试过了，走吧，回去。"
    },
    {
      "id": "L13",
      "arabic": "هُنَاكَ عَمِيلٌ!",
      "chinese": "那儿有个顾客！"
    },
    {
      "id": "L14",
      "arabic": "تَعَالَ إِلَيْنَا وَاسْتَمْتِعْ بِسَلْطَع بُرْجَر اللَّذِيذِ!",
      "chinese": "快过来，尝尝美味的蟹黄堡吧！"
    },
    {
      "id": "L15",
      "arabic": "سَلْطَع بُرْجَر!",
      "chinese": "蟹黄堡！"
    },
    {
      "id": "L16",
      "arabic": "هَا هُوَ!",
      "chinese": "他在那儿！"
    },
    {
      "id": "L17",
      "arabic": "آ...",
      "chinese": "啊——"
    },
    {
      "id": "L18",
      "arabic": "إِلَى أَيْنَ ذَهَبَ؟",
      "chinese": "他跑哪儿去了？"
    },
    {
      "id": "L19",
      "arabic": "إِلَى الْأَعْلَى!",
      "chinese": "上面！"
    },
    {
      "id": "L20",
      "arabic": "سَأُمْسِكُ بِهِ هَذِهِ الْمَرَّةَ!",
      "chinese": "这次我一定要抓住他！"
    },
    {
      "id": "L21",
      "arabic": "أُو...",
      "chinese": "呜——"
    },
    {
      "id": "L22",
      "arabic": "أُوه، هَرَبَ مِنَّا.",
      "chinese": "哎呀，他又跑掉了。"
    },
    {
      "id": "L23",
      "arabic": "هَا!",
      "chinese": "啊！"
    }
  ]
}
