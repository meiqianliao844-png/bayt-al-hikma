{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "智慧宫每日知识包 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "knowledge", "questions"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "knowledge": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "arabic", "meaning", "date", "category"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "arabic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "form": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "grammar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "confusion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "pauseNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "audioUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "collocations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["arabic", "chinese"],
              "properties": {
                "arabic": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                },
                "chinese": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                }
              }
            }
          },
          "verb": {
            "type": "object",
            "additionalProperties": false,
            "required": ["past", "present", "masdar"],
            "properties": {
              "past": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "present": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "masdar": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              }
            }
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "knowledgeId",
          "type",
          "prompt",
          "answer",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "knowledgeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "type": {
            "enum": [
              "zh-ar",
              "ar-choice",
              "zh-fill",
              "ar-zh",
              "preposition",
              "grammar",
              "synonym",
              "interpretation"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          },
          "rubric": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          }
        }
      }
    }
  }
}
